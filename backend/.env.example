# Create from your existing secure .env, never overwrite real credentials.
DATA_DIR=/var/data/yknova
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
FRONTEND_ORIGINS=https://your-site.pages.dev
PUBLIC_SITE_URL=https://your-site.pages.dev
ADMIN_EMAIL=
ADMIN_PASSWORD=
FIREBASE_PROJECT_ID=yknova-studio
# Set 0 in staging after Firebase login works with native ID token
ALLOW_LEGACY_AUTH=0
# Render secret file or Google application credentials, not a source-controlled JSON file:
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-admin.json
# Storage: R2 account / bucket and restricted object key, keep bucket private
REQUIRE_R2=1
R2_ENDPOINT_URL=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=0
